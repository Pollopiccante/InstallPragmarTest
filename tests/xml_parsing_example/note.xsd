<?xml version='1.0' encoding='utf-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:my_namespace" elementFormDefault="qualified">
	<xs:complexType name="SomeTreeNode">
		<xs:sequence>
			<xs:element name="child1" minOccurs="0" maxOccurs="1" type="SomeTreeNodeField" />
			<xs:element name="child2" minOccurs="0" maxOccurs="1" type="SomeTreeNodeField" />
		</xs:sequence>
		<xs:attribute name="myname" type="xs:string" use="required" />
	</xs:complexType>
	<xs:complexType name="RequiredInnerNode">
		<xs:complexContent>
			<xs:extension base="SomeTreeNode">
				<xs:sequence>
					<xs:element name="safe_child" minOccurs="1" maxOccurs="1" type="SomeTreeNodeField" />
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SomeTreeNodeField">
		<xs:choice>
			<xs:element name="RequiredInnerNode" type="RequiredInnerNode" />
			<xs:element name="SomeTreeNode" type="SomeTreeNode" />
		</xs:choice>
	</xs:complexType>
	<xs:element name="root">
		<xs:complexType>
			<xs:choice>
				<xs:element name="SomeTreeNode" type="SomeTreeNode" />
				<xs:element name="RequiredInnerNode" type="RequiredInnerNode" />
			</xs:choice>
		</xs:complexType>
	</xs:element>
</xs:schema>